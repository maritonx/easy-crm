{
  "name": "@easy-cms/db-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL database adapter for Easy CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@easy-cms/drizzle": "workspace:^",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "@easy-cms/core": "workspace:^",
    "@electric-sql/pglite": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@easy-cms/core": "workspace:^",
    "@electric-sql/pglite": "^0.5.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-crm.git",
    "directory": "packages/db-postgres"
  },
  "keywords": [
    "easy-cms",
    "postgres",
    "postgresql",
    "pglite",
    "drizzle"
  ]
}
