{
  "name": "@easy-cms/drizzle",
  "version": "0.0.0",
  "description": "Shared Drizzle ORM layer for Easy CMS database adapters",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3"
  },
  "peerDependencies": {
    "@easy-cms/core": "workspace:^"
  },
  "devDependencies": {
    "@easy-cms/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-crm.git",
    "directory": "packages/drizzle"
  },
  "keywords": [
    "easy-cms",
    "drizzle"
  ]
}
